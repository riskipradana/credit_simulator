#!/usr/bin/env bash
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

# Build JAR if not present (optional: run bin/build first)
if ! ls target/credit-simulator-*.jar 1>/dev/null 2>&1; then
  echo "JAR not found. Running bin/build first..."
  "$SCRIPT_DIR/build"
fi

docker build -t credit-simulator .
if [ $# -gt 0 ]; then
  docker run -it --rm credit-simulator "$@"
else
  docker run -it --rm credit-simulator
fi
